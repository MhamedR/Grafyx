{
  "name": "grafyx-atlas",
  "version": "1.0.0",
  "description": "A reactive, animated map of software structure.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "grafyx-atlas": "dist/server.js"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "node scripts/build.mjs",
    "prepack": "npm --prefix ../.. run build && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MhamedR/Grafyx.git",
    "directory": "packages/atlas"
  },
  "keywords": [
    "dependency-graph",
    "architecture",
    "visualization",
    "monorepo",
    "impact-analysis",
    "build-order",
    "typescript"
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MhamedR/Grafyx/issues"
  },
  "homepage": "https://github.com/MhamedR/Grafyx/tree/main/packages/atlas#readme",
  "dependencies": {
    "grafyx": "^1.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "esbuild": "^0.25.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6"
  }
}
