{
  "name": "grafyx",
  "version": "1.0.1",
  "description": "Framework-agnostic directed graph and reactive engine for TypeScript.",
  "type": "module",
  "main": "./dist/grafyx/index.js",
  "types": "./dist/grafyx/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/grafyx/index.d.ts",
      "import": "./dist/grafyx/index.js",
      "default": "./dist/grafyx/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "import": "./dist/graph/index.js",
      "default": "./dist/graph/index.js"
    },
    "./reactive": {
      "types": "./dist/reactive/index.d.ts",
      "import": "./dist/reactive/index.js",
      "default": "./dist/reactive/index.js"
    },
    "./advanced": {
      "types": "./dist/grafyx/advanced.d.ts",
      "import": "./dist/grafyx/advanced.js",
      "default": "./dist/grafyx/advanced.js"
    },
    "./opentelemetry": {
      "types": "./dist/grafyx/opentelemetry.d.ts",
      "import": "./dist/grafyx/opentelemetry.js",
      "default": "./dist/grafyx/opentelemetry.js"
    },
    "./inspector": {
      "types": "./dist/grafyx/inspector.d.ts",
      "import": "./dist/grafyx/inspector.js",
      "default": "./dist/grafyx/inspector.js"
    },
    "./devtools": {
      "types": "./dist/grafyx/devtools.d.ts",
      "import": "./dist/grafyx/devtools.js",
      "default": "./dist/grafyx/devtools.js"
    },
    "./store": {
      "types": "./dist/grafyx/store.d.ts",
      "import": "./dist/grafyx/store.js",
      "default": "./dist/grafyx/store.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepack": "npm --prefix ../.. run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MhamedR/Graphora.git",
    "directory": "packages/grafyx"
  },
  "keywords": [
    "directed-graph",
    "reactivity",
    "signals",
    "dependency-graph",
    "typescript"
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MhamedR/Graphora/issues"
  },
  "homepage": "https://github.com/MhamedR/Graphora#readme"
}
